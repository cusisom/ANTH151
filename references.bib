@article{Voss1997,
  title = {Adaptive Evolution via a Major Gene Effect: {{Paedomorphosis}} in the {{Mexican}}\,Axolotl},
  shorttitle = {Adaptive Evolution via a Major Gene Effect},
  author = {Voss, S. Randal and Shaffer, H. Bradley},
