@article{Plummer2025,
  title = {The {{First Million Years}} of {{Technology}}: {{The Lomekwian}} and the {{Early Oldowan}}},
  shorttitle = {The {{First Million Years}} of {{Technology}}},
  author = {Plummer, Thomas W. and Harmand, Sonia and Finestone, Emma M. and Wilson, Evan P.},
  year = 2025,
  journal = {Annual Review of Anthropology},
  volume = {54},
  pages = {359--375},
  publisher = {Annual Reviews},
  issn = {1545-4290},
  doi = {10.1146/annurev-anthro-071923-112250},
  urldate = {2026-09-22},
  abstract = {During the course of human evolution, lithic technology became a critical element of hominin foraging ecology and a contributor to feedback loops selecting for increasingly sophisticated tool use, cognition, and language. Here we review the first million years of technology, from 3.3 million years ago (Ma) to 2.3 Ma. This time interval includes the two oldest archaeological industries (the Lomekwian and the early Oldowan) known exclusively from Africa, which collectively overlap with four genera of hominins (human relatives and ancestors). These Early Stone Age (ESA) industries focused on the production and use of sharp edges for cutting, as well as the use of larger, sometimes unworked stones for pounding. We review our current understanding of these technologies, where they were found, how they were made, what they were used for, and the hominins that could have produced them, and consider them in the context of nonhuman primate archaeology.},
  file = {C\:\\Users\\danny\\Zotero\\storage\\NL6U32DU\\Plummer et al. - 2025 - The First Million Years of Technology The Lomekwian and the Early Oldowan.pdf;C\:\\Users\\danny\\Zotero\\storage\\CQKNIXHL\\annurev-anthro-071923-112250.html}
}

